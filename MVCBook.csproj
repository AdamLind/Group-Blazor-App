    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ad176a9f-5c47-4468-8c9f-f773bf2da593</UserSecretsId>
    <RootNamespace>MVCBook</RootNamespace>
    <AssemblyName>MVCBook</AssemblyName>
